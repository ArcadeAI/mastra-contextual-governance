{
  "name": "mastra-contextual-governance",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter '*' build",
    "dev:hooks": "bun run --cwd apps/hooks dev",
    "dev:loan-app": "bun run --cwd apps/loan-app dev",
    "dev:idp": "bun run --cwd apps/loan-app dev:idp",
    "dev:web": "bun run --cwd apps/web dev"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.2"
  },
  "//": "zod is pinned to 3.x on purpose — see DESIGN.md and .env.example. Zod 4 changes internals that the Arcade/Mastra path does not support yet.",
  "overrides": {
    "zod": "3.25.76"
  }
}
