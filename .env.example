# ---------------------------------------------------------------------------
# Contextual Governance — every variable the finished system needs.
#
# Most services do not read these yet: this slice is stubs plus a deploy
# pipeline. The list is complete now so nobody discovers a missing secret
# during integration. Copy to `.env` and fill in.
#
# On Render, the ones marked SECRET are set in the dashboard (sync: false in
# render.yaml, so a blueprint sync prompts for them rather than committing
# them). Never commit a filled-in `.env` — it is gitignored.
# ---------------------------------------------------------------------------

# --- Model ------------------------------------------------------------------
# SECRET. console.anthropic.com → Settings → API keys.
ANTHROPIC_API_KEY=
# Model id kept in env so it can be swapped without a code change.
MODEL_ID=claude-sonnet-5

# --- Arcade -----------------------------------------------------------------
# SECRET. api.arcade.dev dashboard → API keys.
ARCADE_API_KEY=
# The MCP gateway slug you create in the Arcade dashboard. Mastra's MCPClient
# connects to https://api.arcade.dev/mcp/${ARCADE_GATEWAY_ID}.
ARCADE_GATEWAY_ID=
# SECRET. Shared secret Arcade signs hook requests with, so `apps/hooks` can
# reject anything that did not come from the engine. Arcade dashboard →
# Contextual access → your hook → signing secret.
ARCADE_HOOK_SIGNING_SECRET=
# The toolkit name Arcade derives for the registered Remote MCP server. It is a
# normalised form of the server's own serverInfo.name, NOT the dashboard server
# id — read the real value off a /pre payload before writing policy rules.
# See docs/spikes/02-remote-mcp-hooks.md.
ARCADE_LOAN_TOOLKIT=
# Toolkit name for the Python approvals toolkit, after `arcade deploy`.
ARCADE_APPROVALS_TOOLKIT=approvals

# --- Service addresses ------------------------------------------------------
# Addresses of the deployed services. Arcade Cloud calls the hooks over the
# public internet, so these must be reachable — no tunnels in the live path.
#
# These are HOST-form (`host` or `host:port`), NOT full URLs. Render fills
# them in from render.yaml via `fromService`, which can only emit a bare host,
# and blueprints have no string interpolation to prepend a scheme. Deriving
# the host is the point: onrender.com subdomains are global, so a taken
# service name gets silently suffixed and a hardcoded URL would then address
# somebody else's service.
#
# Consumers add the scheme — http for localhost, https otherwise.
HOOKS_PUBLIC_HOST=localhost:8081
LOAN_MCP_PUBLIC_HOST=localhost:8082
WEB_PUBLIC_HOST=localhost:3000
# Browser-visible copy: the control-plane panel subscribes to the hook
# server's SSE stream directly from the client.
NEXT_PUBLIC_HOOKS_HOST=localhost:8081

# --- Databases --------------------------------------------------------------
# bun:sqlite files, seeded from fixtures on boot — which doubles as the demo
# reset. Never committed (*.db is gitignored). On Render these live on the
# service's own disk; each is owned by exactly one service.
GOVERNANCE_DB_PATH=./governance.db
LOANS_DB_PATH=./loans.db

# --- Personas ---------------------------------------------------------------
# Real email identities, so Arcade OAuth genuinely works. The persona switcher
# stands in for real login; the seam for real auth is documented in the README.
PERSONA_DANA_EMAIL=
PERSONA_SAM_EMAIL=
PERSONA_RILEY_EMAIL=
PERSONA_MORGAN_EMAIL=

# --- Slack (approvals toolkit) ----------------------------------------------
# Slack access is brokered by Arcade's stock Slack auth provider, so there is
# no bot token here. The toolkit must request four scopes, not three:
# chat:write, users:read, users:read.email, users.profile:read — users:read is
# a prerequisite for users:read.email. See docs/spikes/03-slack-scopes.md.
#
# Slack channel or user id that approval requests are posted to. Slack →
# right-click the channel → Copy link; the id is the last path segment.
SLACK_APPROVALS_CHANNEL=

# --- Runtime ----------------------------------------------------------------
# Render injects PORT. Locally each service falls back to its own default.
# PORT=
